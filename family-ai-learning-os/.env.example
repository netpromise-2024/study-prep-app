# Set only in your local .env.local / Vercel Environment Variables. Never commit secrets.
DATABASE_URL=postgresql://<NEON_USER>:<NEON_PASSWORD>@<NEON_HOST>/learning_os?sslmode=require
AUTH_SECRET=<GENERATE_RANDOM_32_BYTE_SECRET>
AUTH_GITHUB_ID=<GITHUB_OAUTH_CLIENT_ID>
AUTH_GITHUB_SECRET=<GITHUB_OAUTH_CLIENT_SECRET>
PARENT_GITHUB_ID=<AUTHORIZED_GITHUB_NUMERIC_USER_ID>
# Explicit safety defaults (do not enable until authenticated scheduling is built)
AUTOMATIC_RELEASE_ENABLED=false
AUTOMATIC_SCHEDULE_ENABLED=false
